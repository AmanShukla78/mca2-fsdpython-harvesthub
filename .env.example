# ============================================================
# HarvestHub - Environment Configuration Template
# Copy this file to backend/.env and frontend/.env as needed
# ============================================================

# Backend Settings
DEBUG=True
SECRET_KEY=django-insecure-harvesthub-demo-key-2026-crop-management-agri-hub
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL 8.0 by default, fallback to SQLite if DB_ENGINE=sqlite3)
DB_ENGINE=sqlite3
DB_NAME=harvesthub_db
DB_USER=harvesthub_user
DB_PASSWORD=YourSecurePassword123!
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (VITE_ prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
